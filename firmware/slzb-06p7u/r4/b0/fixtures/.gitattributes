# R4-B0 audit fixtures: text vectors are hashed with LF bytes in their
# manifests, so pin LF line endings on every platform. Without this pin,
# a core.autocrlf=true Windows checkout rewrites them to CRLF and the
# sha256 binding fails before content-binding is reached.
*.hex   text eol=lf
*.json  text eol=lf
*.log   text eol=lf
*.map   text eol=lf
*.txt   text eol=lf
*.xml   text eol=lf
# Binary vectors must never be converted.
*.bin   binary
*.out   binary
